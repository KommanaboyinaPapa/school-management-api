{
  "info": {
    "name": "School Management APIs",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Add School",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/addSchool",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "addSchool"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"ABC School\",\n  \"address\": \"Hyderabad\",\n  \"latitude\": 17.385,\n  \"longitude\": 78.4867\n}"
        },
        "description": "Creates a new school record."
      },
      "response": []
    },
    {
      "name": "List Schools (by proximity)",
      "request": {
        "method": "GET",
        "url": {
          "raw": "{{baseUrl}}/listSchools?latitude=17.385&longitude=78.4867",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "listSchools"
          ],
          "query": [
            {
              "key": "latitude",
              "value": "17.385"
            },
            {
              "key": "longitude",
              "value": "78.4867"
            }
          ]
        },
        "description": "Returns all schools sorted nearest-to-farthest from the given coordinates."
      },
      "response": []
    }
  ],
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:5000"
    }
  ]
}
